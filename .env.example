# --- Neon (database + auth) ---
# Pooled connection string of the branch you develop on (Neon console → Connect, pooling on).
DATABASE_URL=
# Direct (unpooled) connection string of the same branch; used by migrations.
DATABASE_URL_UNPOOLED=
# A label for the branch the URLs above point to. db:reset only runs when this is "dev".
NEON_BRANCH=dev
# Neon Auth: the Auth URL of the same branch (Neon console → Auth → Configuration).
NEON_AUTH_BASE_URL=
# 32+ random characters. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# Direct connection string of a separate Neon branch used only by `npm test` integration tests.
# Must NOT be the same branch as DATABASE_URL. Leave empty to skip those tests.
DATABASE_URL_TEST=

# Public base URL of this app (used for OAuth redirects and links in emails)
APP_URL=http://localhost:3100

# 32 random bytes, base64. Encrypts provider credentials at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# Bearer secret for /api/cron/tick (scheduled collection + alert delivery)
CRON_SECRET=

# Run the scheduler inside the Next.js server process (handy for local dev).
# In production use the cron endpoint or `npm run worker` instead.
RUN_SCHEDULER_IN_PROCESS=true
SCHEDULER_INTERVAL_SECONDS=60

# Dev-only Demo provider with generated sample data (badged "Demo" everywhere)
ENABLE_DEMO_PROVIDER=true

# --- Supabase OAuth integration (optional; personal access tokens work without it) ---
# Register an OAuth app in your Supabase organization settings with redirect URI
#   ${APP_URL}/api/integrations/supabase/oauth/callback
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
SUPABASE_OAUTH_SCOPES="organizations:read projects:read analytics:read database:read edge_functions:read"

# --- Email ---
# EMAIL_TRANSPORT: smtp | resend | console
EMAIL_TRANSPORT=console
EMAIL_FROM="Limit Gauge <alerts@limitgauge.local>"
# Local development: use EMAIL_TRANSPORT=console (emails are printed to the server log).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
